# ---------------------------------------------------------------------------
# Copy to .env and edit.  .env is git-ignored and must NEVER be committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Port the NGINX web tier is published on.
WEB_PORT=8080

# How the API container obtains the JWT signing key at start-up:
#   file  - read the PEM from the Docker secret ./secrets/jwt_private_key
#   vault - fetch it from HashiCorp Vault using AppRole (docker-compose.vault.yml)
SECRET_PROVIDER=file

# Defence in depth for the SSRF fix (V3). Comma separated list of hosts the
# avatar endpoint is allowed to fetch from. Leave empty to fall back to the
# "reject anything that resolves into a private/reserved range" rule.
IMAGE_HOST_ALLOWLIST=

# ---- only used by the Vault overlay ---------------------------------------
# Vault dev-mode root token. Change it. This value is read from .env, which is
# git-ignored, so it is never committed to the repository.
VAULT_TOKEN=replace-with-your-own-dev-token
VAULT_ADDR=http://vault:8200
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=juice-shop
